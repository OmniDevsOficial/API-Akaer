generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

enum Role {
  ADMIN
  VISUALIZADOR
  CHECKER
}

enum norma_status {
  Ativa
  Obsoleta
}

enum solicitacao_status {
  Pendente
  Reprovada
  Aprovada
  Concluida
}

enum tipo_solicitacao {
  NOVA_NORMA
  NOVA_NOTA
  REPORTE_ERRO
}

model User {
  id        Int      @id @default(autoincrement())
  nome      String   @db.VarChar(100)
  email     String   @unique @db.VarChar(225)
  password  String   @db.VarChar(255)
  role      Role     @default(CHECKER)
  ativo     Boolean  @default(true)
  criado_em DateTime @default(now())

  solicitacoes SolicitacaoNorma[]

  @@map("users")
}

model OrgaoEmissor {
  id     Int     @id @default(autoincrement())
  nome   String  @unique @db.VarChar(100)
  normas Norma[]

  @@map("orgao_emissor")
}

model Categoria {
  id     Int     @id @default(autoincrement())
  nome   String  @unique @db.VarChar(100)
  normas Norma[]

  @@map("categoria")
}

model EtapaProjeto {
  id     Int     @id @default(autoincrement())
  nome   String  @unique @db.VarChar(100)
  normas Norma[]

  @@map("etapa_projeto")
}

model Norma {
  id               Int          @id @default(autoincrement())

  // Identificador único desta revisão específica (ex: "AERO-001-A").
  // Mantém compatibilidade com as FKs das tabelas filhas.
  codigo           String       @unique @db.VarChar(50)

  // Critério 1 — Agrupador: identifica que "AERO-001-A" e "AERO-001-B"
  // são revisões do mesmo documento.
  codigo_base      String       @db.VarChar(50)

  titulo           String       @db.VarChar(255)
  orgao_emissor_id Int
  categoria_id     Int
  etapa_projeto_id Int?

  // Revisão torna-se obrigatória para garantir rastreabilidade completa.
  revisao          String       @db.VarChar(20)

  // Critério 3 — Vigência: apenas uma linha com is_vigente = true
  // por codigo_base. Controlado via $transaction no service.
  is_vigente       Boolean      @default(false)

  status           norma_status @default(Ativa)
  data_publicacao  DateTime     @db.Date
  arquivo          String       @db.VarChar(500)
  escopo           String?
  palavras_chave   Json?

  notas               NormaNota[]
  normas_relacionadas NormaRelacionada[] @relation("NormaRelacionadasOrigem")
  relacionada_por     NormaRelacionada[] @relation("NormaRelacionadasDestino")
  solicitacoes        SolicitacaoNorma[]

  orgao_emissor OrgaoEmissor  @relation(fields: [orgao_emissor_id], references: [id])
  categoria     Categoria     @relation(fields: [categoria_id], references: [id])
  etapa_projeto EtapaProjeto? @relation(fields: [etapa_projeto_id], references: [id])

  // Impede duplicatas: não pode existir "AERO-001" revisão "A" duas vezes.
  @@unique([codigo_base, revisao])
  @@map("norma")
}

model NormaNota {
  id           Int    @id @default(autoincrement())
  norma_codigo String @db.VarChar(50)
  texto        String @db.Text
  ordem        Int    @default(0) @db.SmallInt

  norma Norma @relation(fields: [norma_codigo], references: [codigo])

  @@index([norma_codigo])
  @@map("norma_notas")
}

model NormaRelacionada {
  norma_codigo       String @db.VarChar(50)
  relacionada_codigo String @db.VarChar(50)
  ordem              Int    @default(0) @db.SmallInt

  norma       Norma @relation("NormaRelacionadasOrigem", fields: [norma_codigo], references: [codigo])
  relacionada Norma @relation("NormaRelacionadasDestino", fields: [relacionada_codigo], references: [codigo])

  @@id([norma_codigo, relacionada_codigo])
  @@index([relacionada_codigo])
  @@map("norma_relacionada")
}

model SolicitacaoNorma {
  id               Int                @id @default(autoincrement())
  status           solicitacao_status @default(Pendente)
  tipo_solicitacao tipo_solicitacao
  norma_id         String?            @db.VarChar(50)
  dados_propostos  Json?
  motivo_rejeicao  String?            @db.Text
  data_criacao     DateTime           @default(now())

  usuario_id Int
  usuario    User   @relation(fields: [usuario_id], references: [id])
  norma      Norma? @relation(fields: [norma_id], references: [codigo])

  @@map("solicitacoes_normas")
}
